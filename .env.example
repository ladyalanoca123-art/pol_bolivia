APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Zona horaria de Bolivia para Laravel y para la sesión de PostgreSQL.
# Ambas deben tener SIEMPRE el mismo valor: las fechas del sistema asumen America/La_Paz.
APP_TIMEZONE=America/La_Paz
DB_TIMEZONE=America/La_Paz

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pol_bolivia
DB_USERNAME=postgres
DB_PASSWORD=
PG_DUMP_PATH=pg_dump

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=pol_bolivia_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PRODUCCIÓN (POL-Bolivia): valores obligatorios al publicar el sistema.
# No los actives en desarrollo local. La plantilla completa del servidor es .env.production.example.
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_LOCALE=es
# APP_FALLBACK_LOCALE=es
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true      # cookies solo por HTTPS
# SESSION_HTTP_ONLY=true          # JavaScript no puede leer la cookie de sesión
# SESSION_SAME_SITE=lax
# SESSION_LIFETIME=120
# MAIL_FROM_ADDRESS debe ser una dirección REAL del dominio de POL-Bolivia
# (con SPF, DKIM y DMARC configurados), nunca hello@example.com.
# LOG_SEGURIDAD_DAYS=90           # días que se conservan los registros de storage/logs/seguridad-*.log

# ---------------------------------------------------------------------------
# POL-Bolivia: datos propios del sistema (config/pol.php).
# Déjalos comentados para usar los valores de config/pol.php. Si los activas, no los dejes vacíos:
# un valor vacío oculta el botón de WhatsApp o el correo del pie de página.
# ---------------------------------------------------------------------------
# Número de WhatsApp para consultas (botón flotante y teléfono del pie), 8 dígitos sin +591.
# POL_WHATSAPP_CONSULTAS=
# Correo de contacto que aparece en el pie de las páginas públicas.
# POL_CORREO_CONTACTO=
# Contraseña del administrador inicial: solo para la primera instalación (php artisan db:seed).
# Debe cumplir la política de contraseñas. Bórrala del .env después de crear el administrador.
# INITIAL_ADMIN_PASSWORD=
