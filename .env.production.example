# ==========================================================================
# POL-Bolivia — Configuración SEGURA para el servidor de producción
# Copiar como .env en el servidor y completar los valores marcados con < >.
# NUNCA subir el .env real a GitHub.
# ==========================================================================

APP_NAME="POL-Bolivia"
# production: activa HTTPS forzado, HSTS y validación de contraseñas filtradas.
APP_ENV=production
# Generar con: php artisan key:generate
APP_KEY=
# false: los errores NO muestran código, rutas ni consultas al visitante.
APP_DEBUG=false
# Siempre con https://
APP_URL=https://<tu-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Zona horaria de Bolivia para Laravel y para la sesión de PostgreSQL.
# Ambas deben tener SIEMPRE el mismo valor: las fechas del sistema asumen America/La_Paz.
APP_TIMEZONE=America/La_Paz
DB_TIMEZONE=America/La_Paz

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Solo errores (debug escribe demasiada información).
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pol_bolivia
# Usuario propio con permisos mínimos (ver database/sql/crear_usuario_aplicacion.sql).
# NO usar el superusuario "postgres".
DB_USERNAME=pol_bolivia_app
DB_PASSWORD=<contraseña-larga-y-aleatoria>
# Si la base está en otro servidor, usar require.
DB_SSLMODE=prefer
# Ruta de pg_dump para los respaldos automáticos.
PG_DUMP_PATH=pg_dump

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Datos de sesión cifrados en la base de datos.
SESSION_ENCRYPT=true
# La cookie de sesión solo viaja por HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=pol_bolivia_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo real (necesario para verificar cuentas y recuperar contraseñas).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<servidor-smtp>
MAIL_PORT=587
MAIL_USERNAME=<usuario-smtp>
MAIL_PASSWORD=<contraseña-smtp>
MAIL_FROM_ADDRESS="no-responder@<tu-dominio>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
